[sub_resource type="Shader" id="8"]
code = "shader_type canvas_item; //this is a 2D shader

uniform vec4 baseColor : source_color; //uniform means a variable that can be used in fragment

void fragment(){ // tells the engine how every pixel should be colored
	vec4 texColor = texture(TEXTURE, UV);
	COLOR.rgba = vec4(baseColor.r, baseColor.g, baseColor.b, texColor.a);
//	COLOR.rgb = vec3(0.0, 0.0, 0.0);
}"

