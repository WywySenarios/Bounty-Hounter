uniform vec4 baseColor : hint_color; //uniform means a variable that can be used in fragment

void fragment(){ // tells the engine how every pixel should be colored
	vec4 texColor = texture(TEXTURE, UV);
	COLOR.rgba = vec4(baseColor.r, baseColor.g, baseColor.b, texColor.a);
